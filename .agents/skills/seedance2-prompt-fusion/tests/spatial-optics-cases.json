{
  "baseContract": {
    "contractVersion": "spatial-optics-v1",
    "surface": "harness",
    "modelVersion": "seedance-2.5",
    "shotJob": "microacting",
    "readabilityTarget": {
      "primaryEvidence": "眼睑、呼吸与下颌的连续变化",
      "visibleFeatures": ["eyes", "eyelids", "jaw", "breathing"],
      "occlusion": "none",
      "motionBlur": "low",
      "faceFrameHeightRatio": 0.35,
      "measurementSource": "planned_composition"
    },
    "worldMap": {
      "controlledObjects": ["character-001", "phone-001"],
      "cameraZone": "动作轴右侧、人物眼线附近",
      "actionAxis": "人物与手机之间的视线轴",
      "occlusions": [],
      "exits": ["画面右后方过道"]
    },
    "framing": {"shotSize": "close", "subjectFrameShare": 0.55},
    "optics": {
      "focalLengthMm": 50,
      "evidenceTier": "user_supplied",
      "evidence": {
        "id": "user-request-sha-001",
        "surface": "harness",
        "modelVersion": "seedance-2.5",
        "verifiedAt": "2026-08-24"
      }
    },
    "riskFlags": ["strong_angle"],
    "cameraPose": {
      "height": "人物眼线高度",
      "side": "动作轴右侧",
      "distanceOrClearance": "相机与人物保持近景工作距离",
      "aimPoint": "双眼与下颌之间"
    },
    "firstFrame": {
      "mode": "subject_visible",
      "dramaticTask": "人物已在处理手机信息",
      "postRevealState": "人物视线停在手机，拇指仍压住边缘",
      "requireAllSubjectsVisible": true
    },
    "devices": [],
    "changeClass": "none",
    "approvedIntent": {
      "sha256": "814bf63b2734a41f7bba217ad2230bb71d5341310aaa683b98aceac4518b1b43",
      "lockedFields": {"framing.shotSize": "close"},
      "sourcePayload": {"approvalId": "gate-2-001", "lockedFields": {"framing.shotSize": "close"}}
    },
    "adjustments": [],
    "language": {
      "bodyLanguage": "zh-CN",
      "dialogueLanguage": "zh-CN",
      "userRequestedEnglish": false,
      "dialogueTranslatedToEnglish": false
    },
    "motion": {},
    "promptBody": "@素材[character-001]只负责人物身份，不迁移背景。近景从动作轴右侧观察她看完手机后的呼吸、眼睑和下颌变化，人物仍握住手机，最后视线停在屏幕上。",
    "claims": [],
    "sourceMediaTags": ["@素材[character-001]"],
    "outputMediaTags": ["@素材[character-001]"]
  },
  "cases": [
    {
      "name": "complete_contract_passes_but_execution_remains_unverified",
      "expectedStatus": "PASS",
      "expectedCodes": []
    },
    {
      "name": "empty_contract_fails_closed",
      "replaceContract": {},
      "expectedStatus": "FAIL",
      "expectedCodes": ["MISSING_REQUIRED_FIELD"]
    },
    {
      "name": "source_reported_fov_is_not_verified_control",
      "patch": {"optics": {"diagonalFovDeg": 84, "evidenceTier": "source_reported_test"}},
      "expectedStatus": "FAIL",
      "expectedCodes": ["UNVERIFIED_OPTICS_PRECISION"]
    },
    {
      "name": "out_of_range_fov_fails_even_with_runtime_claim",
      "patch": {
        "optics": {
          "diagonalFovDeg": 999,
          "evidenceTier": "current_runtime_verified",
          "evidence": {
            "id": "run-123",
            "surface": "harness",
            "modelVersion": "seedance-2.5",
            "verifiedAt": "2026-08-24",
            "parameterRanges": {"diagonalFovDeg": [20, 120], "focalLengthMm": [16, 135]}
          }
        }
      },
      "expectedStatus": "FAIL",
      "expectedCodes": ["OPTICS_VALUE_OUT_OF_RANGE", "VALUE_OUTSIDE_EVIDENCE_RANGE"]
    },
    {
      "name": "fov_and_focal_length_must_be_physically_consistent",
      "patch": {"optics": {"diagonalFovDeg": 107, "focalLengthMm": 50, "sensorDiagonalMm": 43.3, "projection": "rectilinear"}},
      "expectedStatus": "FAIL",
      "expectedCodes": ["FOV_FOCAL_INCONSISTENCY"]
    },
    {
      "name": "consistent_rectilinear_fov_and_focal_length_pass",
      "patch": {"optics": {"diagonalFovDeg": 46.8, "focalLengthMm": 50, "sensorDiagonalMm": 43.3, "projection": "rectilinear"}},
      "expectedStatus": "PASS",
      "expectedCodes": []
    },
    {
      "name": "dual_exact_optics_requires_sensor_and_projection",
      "patch": {"optics": {"diagonalFovDeg": 46.8, "focalLengthMm": 50}},
      "expectedStatus": "FAIL",
      "expectedCodes": ["MISSING_OPTICAL_GEOMETRY"]
    },
    {
      "name": "microacting_without_scale_evidence_fails",
      "patch": {
        "readabilityTarget": {
          "faceFrameHeightRatio": {"$delete": true},
          "measurementSource": {"$delete": true}
        }
      },
      "expectedStatus": "FAIL",
      "expectedCodes": ["MISSING_MICROACTING_SCALE_EVIDENCE"]
    },
    {
      "name": "microacting_too_small_fails",
      "patch": {"readabilityTarget": {"faceFrameHeightRatio": 0.08}},
      "expectedStatus": "FAIL",
      "expectedCodes": ["READABILITY_CONFLICT"]
    },
    {
      "name": "camera_pose_missing_under_strong_angle_fails",
      "patch": {"cameraPose": {"$delete": true}},
      "expectedStatus": "FAIL",
      "expectedCodes": ["MISSING_REQUIRED_FIELD"]
    },
    {
      "name": "camera_pose_placeholders_fail",
      "patch": {"cameraPose": {"height": "TBD", "side": "somewhere", "distanceOrClearance": "maybe", "aimPoint": "待定"}},
      "expectedStatus": "FAIL",
      "expectedCodes": ["PLACEHOLDER_VALUE"]
    },
    {
      "name": "protected_reveal_requires_executable_fields",
      "patch": {
        "shotJob": "reveal",
        "firstFrame": {
          "mode": "reveal",
          "dramaticTask": "延迟产品出现",
          "postRevealState": "产品完整进入画面",
          "requireAllSubjectsVisible": false,
          "revealTrigger": {"$delete": true},
          "firstVisiblePosition": {"$delete": true}
        }
      },
      "expectedStatus": "FAIL",
      "expectedCodes": ["INCOMPLETE_FIRST_FRAME_EXCEPTION"]
    },
    {
      "name": "pov_recovery_is_normalized_and_protected",
      "patch": {
        "shotJob": "reveal",
        "firstFrame": {
          "mode": "POV_recovery",
          "dramaticTask": "主观曝光恢复",
          "revealTrigger": "白闪退去",
          "firstVisiblePosition": "人物在中央逐渐显现",
          "postRevealState": "人物轮廓和环境恢复",
          "requireAllSubjectsVisible": true
        }
      },
      "expectedStatus": "FAIL",
      "expectedCodes": ["INTENTIONAL_REVEAL_OVERRIDDEN"]
    },
    {
      "name": "dolly_zoom_missing_device_chain_fails",
      "patch": {
        "shotJob": "camera_device",
        "riskFlags": ["moving_camera"],
        "devices": [{"name": "dolly_zoom", "dominant": true}],
        "space": {"mode": "moving"}
      },
      "expectedStatus": "FAIL",
      "expectedCodes": ["MISSING_REQUIRED_FIELD", "MISSING_MOVING_CLEARANCE"]
    },
    {
      "name": "simultaneous_strong_devices_fail",
      "patch": {
        "shotJob": "camera_device",
        "devices": [
          {"name": "dutch_angle", "dominant": true, "intensity": "strong", "simultaneous": true, "setup": "门框建立垂直参照", "trigger": "人物听见门响", "cameraBehavior": "画面向右滚转", "subjectBehavior": "人物继续压住门把", "peak": "门框倾斜最明显", "recovery": "保持倾斜进入末态"},
          {"name": "crash_zoom", "dominant": false, "intensity": "strong", "simultaneous": true, "setup": "人物脸在画面中央", "trigger": "同一声门响", "cameraBehavior": "快速收紧画框", "subjectBehavior": "人物抬眼", "peak": "眼神占满画面", "recovery": "近景稳定"}
        ],
        "cameraPose": {"height": "眼线高度", "side": "动作轴右侧", "distanceOrClearance": "近景工作距离", "aimPoint": "人物双眼", "rollDirection": "画面右侧下沉"}
      },
      "expectedStatus": "FAIL",
      "expectedCodes": ["SIMULTANEOUS_STRONG_DEVICES"]
    },
    {
      "name": "moving_camera_path_clearance_fails",
      "patch": {
        "shotJob": "camera_device",
        "riskFlags": ["moving_camera"],
        "devices": [
          {"name": "dolly_zoom", "dominant": true, "intensity": "strong", "simultaneous": false, "setup": "主体与远背景同框", "trigger": "人物意识到危险", "cameraBehavior": "相机后移同时收窄视野", "subjectBehavior": "人物保持原位并短暂停息", "peak": "主体大小稳定而背景压缩", "recovery": "画面在新距离稳定"}
        ],
        "space": {"mode": "moving", "rigEnvelopeM": 0.8, "dynamicIntrusionMarginM": 0.4, "pathMinClearanceM": 1.0, "startClearanceM": 1.5, "endClearanceM": 1.1}
      },
      "expectedStatus": "FAIL",
      "expectedCodes": ["MOVING_CLEARANCE_CONFLICT"]
    },
    {
      "name": "hidden_locked_field_change_fails_without_self_report",
