{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-failure-record.schema.json",
  "title": "Immutable Generation Failure Record",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "projectId", "id", "segmentId", "outputId", "outputSha256",
    "failureType", "rootCauseKey", "controlRouteFingerprint", "observableProblem",
    "exactTimestampsOrRegions", "observedEvidence", "expectedLockedRequirement",
    "mostLikelyCause", "freeRevisionCompleted", "causalAttribution", "observation", "failedOutputCount",
    "remainingFailureTolerance", "workflowStatus", "humanReviewed", "recordedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "generation_failure_record" },
    "projectId": { "$ref": "execution-event.schema.json#/$defs/projectId" },
    "id": { "$ref": "execution-event.schema.json#/$defs/id" },
    "segmentId": { "$ref": "execution-event.schema.json#/$defs/id" },
    "outputId": { "$ref": "execution-event.schema.json#/$defs/id" },
    "outputSha256": { "$ref": "execution-event.schema.json#/$defs/sha256" },
    "failureType": {
      "enum": ["third_party_asset_audit_fail", "third_party_video_audit_fail", "machine_video_veto"]
    },
    "rootCauseKey": { "$ref": "execution-event.schema.json#/$defs/id" },
    "controlRouteFingerprint": { "$ref": "execution-event.schema.json#/$defs/sha256" },
    "observableProblem": { "type": "string", "minLength": 1 },
    "exactTimestampsOrRegions": {
      "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
    },
    "observedEvidence": {
      "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
    },
    "expectedLockedRequirement": { "type": "string", "minLength": 1 },
    "mostLikelyCause": { "type": "string", "minLength": 1 },
    "freeRevisionCompleted": { "type": "string", "minLength": 1 },
    "causalAttribution": { "$ref": "generation-failure-causal-attribution.schema.json" },
    "observation": { "$ref": "execution-event.schema.json#/$defs/observation" },
    "failedOutputCount": { "type": "integer", "minimum": 1 },
    "remainingFailureTolerance": { "type": "integer", "minimum": 0 },
    "workflowStatus": {
      "enum": ["AWAITING_HUMAN_REVIEW_AFTER_REWORK", "TERMINATED_FAILURE_LIMIT_EXCEEDED"]
    },
    "humanReviewed": { "const": false },
    "recordedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
