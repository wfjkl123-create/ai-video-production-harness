{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-checkpoint.schema.json",
  "title": "Durable Task Checkpoint",
  "type": "object",
  "required": ["schemaVersion", "kind", "taskKey", "contentFingerprintSha256", "taskType", "identity", "status", "maxAttempts", "currentAttempt", "attempts", "outputs", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "task_checkpoint" },
    "taskKey": { "$ref": "#/$defs/sha256" },
    "contentFingerprintSha256": { "$ref": "#/$defs/sha256" },
    "taskType": { "$ref": "#/$defs/id" },
    "identity": {
      "type": "object",
      "required": ["taskType", "inputs", "dependencyKeys", "sourceFact", "storyPlan", "template", "skill", "model", "params", "codeVersion", "policy"],
      "properties": {
        "taskType": { "$ref": "#/$defs/id" },
        "inputs": {},
        "dependencyKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "sourceFact": {}, "storyPlan": {}, "template": {}, "skill": {}, "model": {}, "params": {},
        "codeVersion": { "type": "string", "minLength": 1 },
        "policy": {
          "type": "object", "required": ["paid", "idempotent"],
          "properties": { "paid": { "type": "boolean" }, "idempotent": { "type": "boolean" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "status": { "$ref": "#/$defs/status" },
    "maxAttempts": { "type": "integer", "minimum": 1 },
    "currentAttempt": { "type": ["integer", "null"], "minimum": 1 },
    "attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/output" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" },
    "status": { "enum": ["queued", "running", "succeeded", "failed", "blocked"] },
    "output": {
      "type": "object", "required": ["sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "path": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    },
    "attempt": {
      "type": "object",
      "required": ["attempt", "ownerId", "claimToken", "status", "startedAt", "endedAt", "outputs", "error", "blockReason"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 }, "ownerId": { "$ref": "#/$defs/id" }, "claimToken": { "$ref": "#/$defs/id" },
        "status": { "enum": ["running", "succeeded", "failed", "blocked"] },
        "startedAt": { "type": "string", "format": "date-time" }, "endedAt": { "type": ["string", "null"], "format": "date-time" },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/output" } },
        "error": { "type": ["string", "null"] }, "blockReason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
