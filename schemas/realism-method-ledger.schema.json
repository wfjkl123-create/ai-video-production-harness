{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "realism-method-ledger.schema.json",
  "title": "Realism Method Evidence And Disposition Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "scope", "honestCoverageDefinition", "sources", "methods"],
  "properties": {
    "kind": { "const": "realism_method_ledger_v1" },
    "version": { "const": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "honestCoverageDefinition": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "title", "path", "sha256", "evidenceStatus", "reviewedRange", "visibilityBoundary"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "evidenceStatus": { "enum": ["DIRECT_TEXT_COMPLETE", "DIRECT_VIDEO_TRANSCRIPT_AND_KEYFRAME_REVIEW", "HISTORICAL_DERIVED"] },
          "reviewedRange": { "type": "string", "minLength": 1 },
          "visibilityBoundary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["methodId", "name", "sourceEvidence", "currentCoverage", "disposition", "trigger", "boundary", "ownerLayer", "implementationFiles", "testIds", "promotionStatus"],
        "properties": {
          "methodId": { "type": "string", "pattern": "^RM-[0-9]{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "sourceEvidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["sourceId", "locator"],
              "properties": {
                "sourceId": { "type": "string", "minLength": 1 },
                "locator": { "type": "string", "minLength": 1 }
              }
            }
          },
          "currentCoverage": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["ADOPT", "CONDITIONAL_ADOPT", "EXPERIMENT", "REJECT", "ALREADY_COVERED", "UNVERIFIED"] },
          "trigger": { "type": "string", "minLength": 1 },
          "boundary": { "type": "string", "minLength": 1 },
          "ownerLayer": { "enum": ["intake", "director_ir", "asset", "scene", "performance", "audio", "camera", "compiler", "handoff", "gate3", "gate4", "gate5", "experiment"] },
          "implementationFiles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "testIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "promotionStatus": { "enum": ["IMPLEMENTED", "PARTIAL", "PLANNED", "EXPERIMENT_ONLY", "REJECTED", "UNVERIFIED"] }
        }
      }
    }
  }
}
