{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-fact-analysis.schema.json",
  "title": "Adaptive Source Fact Analysis",
  "type": "object",
  "required": [
    "schemaVersion", "id", "kind", "analysisMode", "status", "revision", "projectId",
    "referenceVideo", "sourceRange", "durationSec", "samplingStrategy", "timeline",
    "factPolicy", "contentFingerprintSha256", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "adaptive_source_analysis" },
    "analysisMode": { "const": "adaptive_source_analysis" },
    "status": { "const": "draft" },
    "revision": { "type": "integer", "minimum": 1 },
    "projectId": { "$ref": "#/$defs/projectId" },
    "referenceVideo": {
      "type": "object",
      "required": ["artifactId", "artifactRevision", "artifactSha256"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "artifactRevision": { "type": "integer", "minimum": 1 },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "sourceRange": {
      "type": "object",
      "required": ["startSec", "endSec"],
      "properties": {
        "startSec": { "const": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "durationSec": { "type": "number", "exclusiveMinimum": 0 },
    "samplingStrategy": {
      "type": "object",
      "required": ["version", "normal", "strongAction"],
      "properties": {
        "version": { "const": "adaptive-source-sampling-v1" },
        "normal": {
          "type": "object",
          "required": ["mode", "targetFps"],
          "properties": {
            "mode": { "const": "uniform_low_frequency" },
            "targetFps": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }
          },
          "additionalProperties": false
        },
        "strongAction": {
          "type": "object",
          "required": ["mode", "targetFps"],
          "properties": {
            "mode": { "const": "dense_action_sampling" },
            "targetFps": { "type": "number", "minimum": 4, "maximum": 8 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/timelineRow" }
    },
    "factPolicy": {
      "type": "object",
      "required": ["observedFactsRequireSourceEvidence", "interpretationIsNonAuthoritative", "uncertaintiesMustRemainExplicit"],
      "properties": {
        "observedFactsRequireSourceEvidence": { "const": true },
        "interpretationIsNonAuthoritative": { "const": true },
        "uncertaintiesMustRemainExplicit": { "const": true }
      },
      "additionalProperties": false
    },
    "contentFingerprintSha256": { "$ref": "#/$defs/sha256" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" },
    "projectId": { "type": "string", "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N}._-]{0,95}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "text": { "type": "string", "pattern": ".*\\S.*" },
    "timelineRow": {
      "type": "object",
      "required": [
        "rowId", "startSec", "endSec", "samplingClass", "samplingReason", "targetFps",
        "sampleTimesSec", "observedFacts", "interpretation", "uncertainties"
      ],
      "properties": {
        "rowId": { "$ref": "#/$defs/id" },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "samplingClass": { "enum": ["normal", "strong_action"] },
        "samplingReason": { "$ref": "#/$defs/text" },
        "targetFps": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 },
        "sampleTimesSec": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0 }
        },
        "observedFacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statement", "modality", "evidenceTimesSec"],
            "properties": {
              "statement": { "$ref": "#/$defs/text" },
              "modality": { "enum": ["visual", "audible"] },
              "evidenceTimesSec": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "number", "minimum": 0 }
              }
            },
            "additionalProperties": false
          }
        },
        "interpretation": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "uncertainties": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
