{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard-panel-repair.schema.json",
  "title": "Deterministic Storyboard Panel Repair Plan",
  "type": "object",
  "required": ["id", "kind", "source", "replacements", "outputPath", "renderer"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "const": "storyboard_panel_repair_plan" },
    "source": {
      "type": "object",
      "required": ["artifactId", "path", "sha256", "grid"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "grid": {
          "type": "object", "required": ["rows", "columns", "width", "height"],
          "properties": { "rows": { "type": "integer", "minimum": 1 }, "columns": { "type": "integer", "minimum": 1 }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "replacements": { "type": "array", "minItems": 1 },
    "outputPath": { "type": "string", "minLength": 1 },
    "renderer": { "const": "ffmpeg-lossless-storyboard-panel-repair-v1" }
  },
  "additionalProperties": true
}
