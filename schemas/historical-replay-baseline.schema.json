{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical-replay-baseline.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "window", "scope", "aggregate", "ledgerBaseline", "shadowFunnel", "projects", "excluded", "unreadable", "hardErrorRate", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "historical_replay_baseline" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "window": {
      "type": "object",
      "required": ["from", "through", "timeZoneOffset", "startInclusive", "endExclusive"],
      "properties": {
        "from": { "type": "string", "format": "date" },
        "through": { "type": "string", "format": "date" },
        "timeZoneOffset": { "type": "string", "pattern": "^[+-](?:0\\d|1\\d|2[0-3]):[0-5]\\d$" },
        "startInclusive": { "type": "string", "format": "date-time" },
        "endExclusive": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "scope": { "type": "object" },
    "aggregate": { "type": "object" },
    "ledgerBaseline": { "type": "object" },
    "shadowFunnel": { "$ref": "shadow-funnel-projection.schema.json" },
    "projects": { "type": "array", "items": { "type": "object" } },
    "excluded": { "type": "array", "items": { "type": "object" } },
    "unreadable": { "type": "array", "items": { "type": "object" } },
    "hardErrorRate": {
      "type": "object",
      "required": ["value", "status", "reason"],
      "properties": {
        "value": { "type": "null" },
        "status": { "const": "unknown" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "limitations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
