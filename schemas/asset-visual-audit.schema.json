{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-visual-audit.schema.json",
  "title": "Multimodal Asset Visual Audit",
  "type": "object",
  "required": ["id", "kind", "assetId", "assetType", "assetRevision", "assetSha256", "decision", "inspectionMode", "inspectorContextMode", "inspectorTaskId", "observedIdentityCount", "checks", "blockerCount", "reviewedAt"],
  "properties": {
    "id": { "type": "string", "pattern": ".*\\S.*" },
    "kind": { "const": "asset_visual_audit" },
    "assetId": { "type": "string", "pattern": ".*\\S.*" },
    "assetType": { "type": "string", "pattern": ".*\\S.*" },
    "assetRevision": { "type": "integer", "minimum": 1 },
    "assetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "enum": ["PASS", "FAIL"] },
    "inspectionMode": { "const": "multimodal_pixels" },
    "inspectorContextMode": { "const": "clean_zero_context" },
    "inspectorTaskId": { "type": "string", "pattern": ".*\\S.*" },
    "observedIdentityCount": { "type": "integer", "minimum": 0 },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "result", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": ".*\\S.*" },
          "result": { "enum": ["PASS", "FAIL", "NA"] },
          "evidence": { "type": "string", "pattern": ".*\\S.*" },
          "impact": { "type": "string" }, "correction": { "type": "string" }
        }, "additionalProperties": false
      }
    },
    "blockerCount": { "type": "integer", "minimum": 0 },
    "reviewedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
