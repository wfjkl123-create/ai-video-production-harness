{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-observation-evidence.schema.json",
  "title": "Execution Observation Evidence Receipt",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "id", "evidencePath", "observedAt", "actor",
    "segmentId", "correlationId", "causationId", "sourceReferences", "observation"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "execution_observation_evidence" },
    "id": { "$ref": "execution-event.schema.json#/$defs/id" },
    "evidencePath": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["system", "human", "delegated_policy"] },
        "id": { "oneOf": [{ "$ref": "execution-event.schema.json#/$defs/id" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "segmentId": { "oneOf": [{ "$ref": "execution-event.schema.json#/$defs/id" }, { "type": "null" }] },
    "correlationId": { "oneOf": [{ "$ref": "execution-event.schema.json#/$defs/id" }, { "type": "null" }] },
    "causationId": { "oneOf": [{ "$ref": "execution-event.schema.json#/$defs/id" }, { "type": "null" }] },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "id", "path", "sha256"],
        "properties": {
          "kind": { "$ref": "execution-event.schema.json#/$defs/id" },
          "id": { "$ref": "execution-event.schema.json#/$defs/id" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "execution-event.schema.json#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "observation": { "$ref": "execution-event.schema.json#/$defs/observation" }
  },
  "additionalProperties": false
}
