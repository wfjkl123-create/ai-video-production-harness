RUNNINGHUB_API_KEY=
# Required for the canonical Seedance prompt-authoring route. This is the
# bundled, hash-verified MIT v6.7.0 baseline. Use an absolute path only when
# intentionally replacing it with a separately reviewed release.
HARNESS_CANONICAL_PROMPT_SKILL_ROOT=./.agents/skills/seedance2-prompt
# Optional executable overrides for non-default installations.
HARNESS_LIBTV_EXECUTABLE=
HARNESS_FFPROBE_EXECUTABLE=
# Studio local runtime. Keep the state and project paths outside Git.
HARNESS_PROJECTS_ROOT=
HARNESS_STUDIO_STATE_ROOT=
HARNESS_STUDIO_HOST=127.0.0.1
HARNESS_STUDIO_PORT=4177
HARNESS_STUDIO_MAX_UPLOAD_BYTES=2147483648
HARNESS_DIRECTOR_MAX_BUDGET_USD=0.25
# 主机固定的独立复核策略；网页不会向项目操作者展示或要求填写这些值。
# Kimi 网关以已返回的用量按下列主机单价换算，不要求不存在的单独积分回执。
HARNESS_STUDIO_AUDIT_MAX_TURNS=2
HARNESS_STUDIO_AUDIT_MAX_CREDITS=1200
HARNESS_STUDIO_AUDIT_INPUT_CREDITS_PER_MILLION=20000
HARNESS_STUDIO_AUDIT_OUTPUT_CREDITS_PER_MILLION=30000
HARNESS_STUDIO_AUDIT_PRICING_SOURCE=本机独立审查默认配额
HARNESS_STUDIO_AUDIT_PRICING_VERIFIED_AT=2026-08-21T00:00:00.000Z
